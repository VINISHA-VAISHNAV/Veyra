# ==========================================
# VEYRA Server Environment Configuration
# ==========================================

# Server Port
PORT=5000

# MongoDB Connection String
# Replace with your MongoDB Atlas URI:
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/veyra?retryWrites=true&w=majority
# Or use local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/veyra

# JSON Web Token Secret Key
JWT_SECRET=veyra_jwt_super_secret_key_production_2026

# Default Admin Credentials (automatically seeded if not present)
ADMIN_EMAIL=admin@veyra.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=VEYRA Administrator
